# ── Server ────────────────────────────────────────────────────────────────────
PORT=10000
NODE_ENV=production
BASE_PATH=/

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string
# Format: mongodb+srv://user:password@cluster.mongodb.net/priya?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/priya?retryWrites=true&w=majority

# ── Discord Self-Bot ───────────────────────────────────────────────────────────
# Your Discord USER token (not a bot token)
# How to get: Open Discord in browser → F12 → Network tab → any request → Headers → Authorization
DISCORD_USER_TOKEN=your-discord-user-token-here

# ── Discord OAuth2 (for user portal login) ────────────────────────────────────
# From: discord.com/developers/applications → Your App → OAuth2
DISCORD_CLIENT_ID=your-discord-application-client-id-here
DISCORD_CLIENT_SECRET=your-discord-client-secret-here

# The EXACT redirect URI added in Discord Developer Portal → OAuth2 → Redirects
# Replace with your actual Render URL:
DISCORD_REDIRECT_URI=https://YOUR-APP-NAME.onrender.com/api/auth/discord/callback

# ── Owner ──────────────────────────────────────────────────────────────────────
# Your Discord user ID (right-click your name in Discord → Copy User ID)
OWNER_DISCORD_ID=your-discord-user-id-here

# ── Dashboard Auth ─────────────────────────────────────────────────────────────
# Password to log into the owner dashboard (pick something strong)
DASHBOARD_SECRET=change-me-to-a-strong-password

# Secret for signing JWT tokens (generate with: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-random-32-char-hex-string

# ── AI API Keys (add at least one) ────────────────────────────────────────────
# Groq (fast, free tier): https://console.groq.com/keys
GROQ_API_KEY_1=

# Google Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY_1=

# Nvidia NIM: https://build.nvidia.com/
NVIDIA_API_KEY_1=

# ── Site URL ───────────────────────────────────────────────────────────────────
# Your Render app's public URL (no trailing slash)
SITE_URL=https://YOUR-APP-NAME.onrender.com
